generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  WORKER
  DEPARTMENT_MANAGER
  SUPER_ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  googleId      String?
  name          String
  phone         String?
  role          Role      @default(CITIZEN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  complaintsFiled   Complaint[] @relation("CitizenComplaints")
  complaintsAssigned Complaint[] @relation("WorkerComplaints")
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  statusHistory     StatusHistory[]
  notifications     Notification[]
  feedbacks         Feedback[]
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  complaints  Complaint[]
}

model Ward {
  id          String   @id @default(uuid())
  name        String
  polygon     String?  // JSON string or GeoJSON for ward boundary
  complaints  Complaint[]
}

model Complaint {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String
  priority        Priority @default(LOW)
  status          ComplaintStatus @default(SUBMITTED)
  
  latitude        Float?
  longitude       Float?
  address         String?
  
  aiCategory      String?
  aiPriority      Priority?
  aiConfidence    Float?
  aiSummary       String?

  citizenId       String
  citizen         User     @relation("CitizenComplaints", fields: [citizenId], references: [id])
  
  workerId        String?
  worker          User?    @relation("WorkerComplaints", fields: [workerId], references: [id])

  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])

  wardId          String?
  ward            Ward?    @relation(fields: [wardId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?

  images          ComplaintImage[]
  statusHistory   StatusHistory[]
  feedbacks       Feedback[]
}

model ComplaintImage {
  id            String   @id @default(uuid())
  url           String
  isAfterPhoto  Boolean  @default(false)
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id])
  createdAt     DateTime @default(now())
}

model StatusHistory {
  id            String   @id @default(uuid())
  status        ComplaintStatus
  notes         String?
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id])
  changedById   String
  changedBy     User      @relation(fields: [changedById], references: [id])
  createdAt     DateTime @default(now())
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Feedback {
  id            String   @id @default(uuid())
  rating        Int
  comment       String?
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
}
